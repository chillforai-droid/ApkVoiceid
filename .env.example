# यही Supabase project जो आपकी वेबसाइट इस्तेमाल करती है
# (web app के .env में VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY जैसी वैल्यू)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# आपकी deployed वेबसाइट का पूरा URL (जैसे https://voiceid.vercel.app)
# — ऐप वॉइस/इमेज अपलोड-डाउनलोड के लिए इसी की /api/media/* APIs इस्तेमाल करता है
API_BASE_URL="https://your-deployed-site.vercel.app"

# लोकल पर टेस्ट करने के लिए: इस फाइल को .env के नाम से कॉपी करें और असली वैल्यू भरें।
# GitHub Actions से APK बिल्ड करने के लिए: इन तीनों को repo Settings > Secrets and
# variables > Actions में SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE_URL नाम से जोड़ें।
